cat > .gitignore << 'EOF'
# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Dependencies
**/node_modules/
node_modules/

# Build files
**/dist/
dist
dist-ssr
**/build/
build
**/.vite/
.vite/

# Environment files
*.local
.env
.env.local
.env.production

# Package files
package-lock.json
yarn.lock
pnpm-lock.yaml

# Backend specific
Backend/uploads/
Backend/.env

# Frontend specific
Frontend/.vite/
Frontend/dist/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS files
Thumbs.db
desktop.ini
EOF